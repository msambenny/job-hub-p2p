# Claude (job/profile extraction). Any credential the Anthropic SDK resolves works.
ANTHROPIC_API_KEY=
HUB_MODEL=claude-opus-5-5
# Set to 0 to use the rule-based "Label: value" parser only.
HUB_USE_LLM=1

# WhatsApp Cloud API (Meta developer app -> WhatsApp -> API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string; enter the same value as the webhook "Verify token" in Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to check X-Hub-Signature-256 on webhook calls.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved utility template with three body variables: {{1}} title, {{2}} company, {{3}} apply link.
WHATSAPP_ALERT_TEMPLATE=job_match_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Hub behaviour
HUB_DATA_DIR=data
# Comma-separated moderator numbers, international format.
HUB_ADMINS=
HUB_MAX_AGE_DAYS=15
HUB_MAX_ALERTS_PER_DAY=5
HUB_BACKFILL_LIMIT=3
HUB_VALIDATION_TIMEOUT=20
